# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database — leave DATABASE_URL empty to use SQLite (zero setup, dev only).
# For Supabase free tier:
#   DATABASE_URL  = the "Transaction" pooler URL  (port 6543)
#   DIRECT_URL    = the "Session" pooler URL       (port 5432)
# Both are found in Supabase → Settings → Database → Connection string
DATABASE_URL=""
DIRECT_URL=""

# App
APP_URL="http://localhost:3000"

# Session — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# n8n translation webhook (fill in later)
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Seed data (only used by npm run db:seed)
SEED_DEFAULT_PASSWORD="ChangeMe123!"

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"

